+class HealthSystem : public EntitySystem {
+public:
+    static constexpr float kUpdateInterval = 1.0f / 60.0f; // seconds
+
+    HealthSystem();
+    ~HealthSystem() override;
+
+    void Update(Time::Delta delta) override;
+};
+
+#endif // HEALTH_SYSTEM_H


# src/gameplay/systems/HealthSystem.cpp
--- a/src/gameplay/systems/HealthSystem.cpp
+++ b/src/gameplay/systems/HealthSystem.cpp
@@ -0,0 +1,12 @@
+#include "HealthSystem.h"
+
+HealthSystem::HealthSystem()
+    : EntitySystem("HealthSystem") {}
+
+HealthSystem::~HealthSystem() {}
+
+void HealthSystem::Update(Time::Delta delta) {
+    for (Entity* entity : GetEntities<HealthComponent>()) {
+        entity->GetComponent<HealthComponent>()->Update(delta);
+    }
+}


