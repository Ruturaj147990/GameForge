{
  "schema_version": "1.0.0",
  "config_name": "GameForge Step 7 SFT Prototype Training Configuration",
  "governing_policy": "GAMEFORGE_FINAL_MASTER_STRATEGY.md Section 5.1-5.6, 28.4, 30.1.3",
  "type": "object",
  "required": [
    "experiment_id",
    "base_model",
    "training_method",
    "dataset",
    "hyperparameters",
    "resource_budget",
    "evaluation_manifest",
    "stopping_criteria"
  ],
  "properties": {
    "experiment_id": { "type": "string" },
    "created_at": { "type": "string" },
    "base_model": {
      "type": "object",
      "required": ["candidate_id", "model_name", "immutable_revision", "license"],
      "properties": {
        "candidate_id": { "type": "string" },
        "model_name": { "type": "string" },
        "immutable_revision": { "type": "string" },
        "license": { "type": "string" },
        "context_window": { "type": "integer" }
      }
    },
    "training_method": {
      "type": "string",
      "enum": ["lora", "qlora", "sft_full", "prefix_tuning"]
    },
    "adapter_config": {
      "type": "object",
      "properties": {
        "r": { "type": "integer" },
        "lora_alpha": { "type": "integer" },
        "lora_dropout": { "type": "number" },
        "target_modules": { "type": "array", "items": { "type": "string" } },
        "bias": { "type": "string" }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["manifest_path", "manifest_digest", "split_policy_version", "source_register_path"],
      "properties": {
        "manifest_path": { "type": "string" },
        "manifest_digest": { "type": "string" },
        "split_policy_version": { "type": "string" },
        "source_register_path": { "type": "string" },
        "admitted_sample_types": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hyperparameters": {
      "type": "object",
      "required": ["learning_rate", "batch_size", "gradient_accumulation_steps", "epochs", "seed"],
      "properties": {
        "learning_rate": { "type": "number" },
        "batch_size": { "type": "integer" },
        "gradient_accumulation_steps": { "type": "integer" },
        "epochs": { "type": "integer" },
        "seed": { "type": "integer" },
        "optimizer": { "type": "string" },
        "lr_scheduler": { "type": "string" },
        "max_seq_length": { "type": "integer" }
      }
    },
    "resource_budget": {
      "type": "object",
      "required": ["device", "max_vram_gb", "max_disk_gb"],
      "properties": {
        "device": { "type": "string" },
        "precision": { "type": "string" },
        "max_vram_gb": { "type": "number" },
        "max_disk_gb": { "type": "number" },
        "checkpoint_cadence_steps": { "type": "integer" },
        "output_dir": { "type": "string" }
      }
    },
    "evaluation_manifest": {
      "type": "object",
      "required": ["frozen_manifest_id", "held_out_tasks", "general_reasoning_tasks"],
      "properties": {
        "frozen_manifest_id": { "type": "string" },
        "held_out_tasks": { "type": "array", "items": { "type": "string" } },
        "general_reasoning_tasks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stopping_criteria": {
      "type": "object",
      "required": ["min_game_gain_threshold", "max_general_regression_threshold"],
      "properties": {
        "min_game_gain_threshold": { "type": "number" },
        "max_general_regression_threshold": { "type": "number" },
        "early_stopping_patience": { "type": "integer" }
      }
    }
  }
}
